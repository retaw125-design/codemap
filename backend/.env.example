# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다 (.gitignore).
# 운영(Railway)에서는 .env 대신 Railway 대시보드의 변수로 설정한다.

# development | production. production이면 에러 응답에 detail을 넣지 않는다.
APP_ENV=development

# Supabase Session pooler 연결 문자열 (Connect → Session pooler).
# 로컬은 시험(staging) 프로젝트, 운영은 운영(prod) 프로젝트 주소를 쓴다.
# 비어 있으면 앱은 뜨지만 /health가 503 DATABASE_UNAVAILABLE을 돌려준다.
DATABASE_URL=

# Cloudflare Pages 프로젝트 이름 (예: codemap). 주소가 아니라 이름만 쓴다.
# https://<이름>.pages.dev와 미리보기 https://<무엇이든>.<이름>.pages.dev를 CORS로 허용한다.
# 비어 있으면 로컬 개발 주소(localhost:5173)만 허용한다.
PAGES_PROJECT_NAME=
